model Content {
  id              String        @id @default(uuid())
  channelId       String?
  channel         Channel?       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title           String?
  description     String?       @db.Text // বড় ডেসক্রিপশনের জন্য Text টাইপ ভালো
  contentType     ContentType?   // VOD || LIVE_STREAM
  status          ContentStatus @default(PROCESSING)  // PROCESSING AVAILABLE FAILED PRIVATE ARCHIVED ENDED
  durationSeconds Int?
  
  // Playback & Storage Refactor
  playbackUrl     String?       // https://pub-xxx.r2.dev/videos/lessonId/index.m3u8
  r2Prefix        String?       // videos/lessonId (সম্পূর্ণ ফোল্ডার পাথ মনে রাখা সহজ)
  originalFileName String?      // আপলোড করা অরিজিনাল ফাইলের নাম (উদা: my_video.mp4)
  thumbnailUrl    String?
  
  views           Int           @default(0)
  isPremium       Boolean       @default(false)
  isShadowBanned  Boolean       @default(false)
  fileSize        BigInt?       // Storage usage in bytes
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  watchHistory    WatchHistory[]

  @@index([channelId]) // কুয়েরি স্পিড বাড়ানোর জন্য ইনডেক্স
  @@map("content")
}