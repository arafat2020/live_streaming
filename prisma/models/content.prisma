model Content {
  id String @id @default(uuid())

  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  title           String?
  description     String?       @db.Text
  contentType     ContentType?
  status          ContentStatus @default(PROCESSING) // PROCESSING AVAILABLE FAILED PRIVATE ARCHIVED ENDED
  durationSeconds Int?
  category        String?

  // Playback & Storage Refactor
  playbackUrl      String?
  r2Prefix         String?
  originalFileName String?
  thumbnailUrl     String?

  views          Int     @default(0)
  isPremium      Boolean @default(false)
  isShadowBanned Boolean @default(false)
  fileSize       BigInt? // Storage usage in bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  watchHistory WatchHistory[]
  viewTracks   ViewTrack[]

  @@index([channelId])
  @@map("content")
}
