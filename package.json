{
  "name": "rappio-server",
  "version": "0.0.1",
  "description": "Backend server for the Rappio TV entertainment platform, providing APIs for video streaming, user interaction, live comments, real-time updates, and media management.",
  "author": "Tareq",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "npx prisma generate",
    "build": "nest build",
    "start": "npx prisma migrate deploy && npx prisma generate && node dist/main.js",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --ignore-path .prettierignore --check \"**/*.+(js|ts|json)\"",
    "format:fix": "prettier --ignore-path .prettierignore --write \"**/*.+(js|ts|json)\"",
    "ci:fix": "npm run lint:fix && npm run format:fix"
  },
  "prisma": {
    "schema": "./prisma"
  },
  "dependencies": {
    "@aws-sdk/client-mediaconvert": "^3.1044.0",
    "@aws-sdk/client-medialive": "^3.1044.0",
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/lib-storage": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.946.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.9",
    "@prisma/client": "^6.18.0",
    "@types/bcrypt": "^5.0.2",
    "@types/passport-google-oauth20": "^2.0.17",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudflare": "^5.2.0",
    "cloudinary": "^1.41.3",
    "csv-parser": "^3.2.0",
    "date-fns": "^4.1.0",
    "form-data": "^4.0.5",
    "google-auth-library": "^10.5.0",
    "ioredis": "^5.8.2",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "node-fetch": "^3.3.2",
    "node-media-server": "^4.2.2",
    "p-limit": "^7.2.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "stream": "^0.0.3",
    "stripe": "^18.2.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.7",
    "@types/node-media-server": "^2.3.7",
    "@types/nodemailer": "^7.0.2",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "nodemailer": "^7.0.9",
    "prettier": "^3.4.2",
    "prisma": "^6.18.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
